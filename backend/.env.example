# Music Galaxy Backend - Node.js + Express + TypeScript
# Configuração de ambiente para desenvolvimento local

# Porta do servidor
PORT=3001

# Ambiente
NODE_ENV=development

# Configuração do Banco de Dados MariaDB
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=musicgalaxy

# Rate Limiting da API
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS (em desenvolvimento, permite todas as origens)
CORS_ORIGIN=*

# Integrações com APIs Externas (MusicBrainz, Discogs)
MUSICBRAINZ_USER_AGENT=MusicGalaxy/1.0 (contato: seu-email@exemplo.com)
DISCOGS_TOKEN=seu_token_pessoal_discogs
DISCOGS_USER_AGENT=MusicGalaxy/1.0

# ============================================================
# Reconhecimento sonoro (POST /api/recognize)
# ============================================================
# A credencial fica SOMENTE no backend. Nunca vai para o aplicativo,
# para o APK nem para log.
# Sem AUDD_TOKEN a rota responde 503 com a mensagem de serviço não
# configurado — o aplicativo continua com a busca por texto funcionando.
RECOGNITION_PROVIDER=audd
AUDD_TOKEN=seu_token_de_desenvolvedor_audd

# Limite de tentativas de reconhecimento por janela de tempo.
RECOGNITION_RATE_LIMIT_WINDOW_MS=900000
RECOGNITION_RATE_LIMIT_MAX_REQUESTS=20

{
  "expo": {
    "name": "Music Galaxy",
    "slug": "musicgalaxy",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "musicgalaxy",
    "icon": "./assets/icon.png",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0F0F1A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.musicgalaxy.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F0F1A"
      },
      "package": "com.musicgalaxy.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "newArchEnabled": false
  }
}

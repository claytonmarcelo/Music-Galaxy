{
  "expo": {
    "name": "Music Galaxy",
    "slug": "musicgalaxy",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "musicgalaxy",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.musicgalaxy.app"
    },
    "android": {
      "package": "com.musicgalaxy.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B1A"
        }
      ],
      "expo-audio"
    ],
    "platforms": [
      "ios",
      "android",
      "web"
    ]
  }
}

{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2020"],
    "rootDir": "..",
    "outDir": "../dist-tests",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["../src/types/index.ts", "../src/services/reconhecimentoContrato.ts", "./**/*.ts"],
  "exclude": ["node_modules", "../dist-tests"]
}

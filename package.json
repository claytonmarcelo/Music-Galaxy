{
  "name": "musicgalaxy",
  "version": "1.0.0",
  "description": "Music Galaxy - Aplicativo de busca musical com precisão de dados",
  "private": true,
  "workspaces": [
    "mobile",
    "backend"
  ],
  "scripts": {
    "start": "npm --workspace mobile run start",
    "web": "npm --workspace mobile run web",
    "android": "npm --workspace mobile run android",
    "ios": "npm --workspace mobile run ios",
    "install:all": "npm install",
    "dev:mobile": "npm --workspace mobile run start",
    "dev:backend": "npm --workspace backend run dev",
    "dev": "concurrently --names backend,mobile --prefix-colors cyan,magenta \"npm run dev:backend\" \"npm run dev:mobile\"",
    "build:backend": "npm --workspace backend run build",
    "typecheck": "npm --workspace backend run typecheck && npm --workspace mobile run typecheck",
    "test": "npm --workspace backend run test",
    "test:api": "npm --workspace backend run test:api"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3"
  }
}